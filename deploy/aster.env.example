NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=96
# Host address for reverse proxy access, not its public interface.
HOST=127.0.0.1
PORT=4180
SSH_TARGET=
WORKSPACE_LABEL=VPS
TASK_COMMAND=/usr/local/bin/task
TASKRC=/etc/taskwarrior/taskrc
ORGANIZATION_FILE=/opt/aster/data/organization.json
RECOVERY_FILE=/opt/aster/data/recovery.json
TIME_DB_FILE=/opt/aster/data/time.sqlite
STATE_LOG_FILE=/opt/aster/data/state-history.jsonl
WORKSPACE_SOCKET=/opt/aster/data/workspace.sock
TIME_ENABLED=1
PUBLIC_ORIGIN=https://tasks.example.com
