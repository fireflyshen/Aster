NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=96
# Host address for reverse proxy access, not its public interface.
HOST=172.19.0.1
PORT=4180
SSH_TARGET=
TASK_COMMAND=/usr/local/bin/task
TASKRC=/etc/taskwarrior/taskrc
ORGANIZATION_FILE=/opt/aster/data/organization.json
PUBLIC_ORIGIN=https://task.caten.top
CF_ACCESS_TEAM_DOMAIN=https://fireflyshen.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_ASTER_APPLICATION_AUD
