{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "modules/core/**/*.ts",
    "modules/desktop/src/**/*.ts",
    "modules/desktop/src/**/*.tsx",
    "modules/desktop/raycast-env.d.ts"
  ]
}
