{
  "name": "aster",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Manage Taskwarrior 3 tasks across Raycast desktop, Web, TUI, and MCP.",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix modules/desktop run dev",
    "build": "npm --prefix modules/desktop run build",
    "lint": "npm --prefix modules/desktop run lint",
    "fix-lint": "npm --prefix modules/desktop run fix-lint",
    "format": "prettier --write modules/core modules/desktop/src README.md package.json modules/desktop/package.json",
    "publish": "npm --prefix modules/desktop run publish",
    "typecheck": "tsc --noEmit",
    "check:core": "tsc -p modules/core/tsconfig.json --noEmit",
    "check:desktop": "npm --prefix modules/desktop run check",
    "dev:desktop": "npm --prefix modules/desktop run dev",
    "build:desktop": "npm --prefix modules/desktop run build",
    "dev:server": "npm --prefix modules/server run dev",
    "build:server": "npm --prefix modules/server run build",
    "check:server": "npm --prefix modules/server run check",
    "test:server": "npm --prefix modules/server run test",
    "dev:web": "npm --prefix modules/web run dev",
    "build:web": "npm --prefix modules/web run build",
    "check:web": "npm --prefix modules/web run check",
    "test:web": "npm --prefix modules/web run test",
    "deploy": "bash deploy/deploy.sh",
    "start:mcp": "npm --prefix modules/mcp start",
    "check:mcp": "npm --prefix modules/mcp run check",
    "test:mcp": "npm --prefix modules/mcp test",
    "test": "npm run test:web && npm run build:web && npm run test:server && npm run test:mcp"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
