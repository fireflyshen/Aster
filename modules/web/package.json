{
  "name": "@aster/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development SSH_TARGET=rn node --experimental-strip-types server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --packages=external --platform=node --format=esm --outfile=../../dist/web/server.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && npm run build && node --test tests/server.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.27.7",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.8.2",
    "vite": "^7.0.0"
  }
}
