{
  "name": "@aster/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "SSH_TARGET=dmit node --experimental-strip-types src/index.ts",
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --outfile=../../dist/server/server.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && npm run build && node --test tests/server.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.27.7",
    "typescript": "^5.8.2"
  }
}
